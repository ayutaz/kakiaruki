{
  "name": "one-stroke-evolution-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.4.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "node bench/population-benchmark.ts",
    "experiment": "node bench/evolution-experiment.ts",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build",
    "verify": "npm run test && npm run build",
    "soak": "node bench/soak.ts"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "phaser-box2d": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "24.10.9",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
